# O Supabase injeta SUPABASE_URL e a chave de serviço no ambiente da Edge Function.
# Se o projeto utilizar chaves legadas, SUPABASE_SERVICE_ROLE_KEY também é aceita.
SUPABASE_SERVICE_ROLE_KEY=

# Informe somente origens exatas, separadas por vírgula. Não inclua caminhos.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://www.seudominio.com.br,https://seudominio.com.br
PUBLIC_RATE_LIMIT_SALT=gere-um-segredo-aleatorio-de-pelo-menos-24-caracteres

# WhatsApp Business Cloud API: todos os valores permanecem no backend.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NOTIFY_TO=
WHATSAPP_TEMPLATE_NAME=connecta_novo_pedido
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_GRAPH_API_VERSION=
